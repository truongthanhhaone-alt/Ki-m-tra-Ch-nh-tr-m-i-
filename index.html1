];
	

// Hàm tự động in câu hỏi ra ngoài giao diện HTML
function renderQuestions() {
    const container = document.getElementById("questionsContainer");
    if (!container) return;
    container.innerHTML = ""; 

    questions.forEach((q, index) => {
        let optionsHTML = q.options.map((opt, i) => `
            <label class="flex items-center space-x-2 p-2 hover:bg-gray-50 rounded cursor-pointer block">
                <input type="radio" name="question_${q.id}" value="${i}" class="form-radio text-blue-600">
                <span>${opt}</span>
            </label>
        `).join("");

        container.innerHTML += `
            <div class="bg-white p-5 rounded-lg shadow-sm border border-gray-200 mb-4">
                <p class="font-semibold text-gray-800 mb-3">${q.question}</p>
                <div class="space-y-1">${optionsHTML}</div>
            </div>
        `;
    });
}

    loadLeaderboard();
  </script>

</body>
</html>