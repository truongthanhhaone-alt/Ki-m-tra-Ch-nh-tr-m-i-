        question: "Câu 2: Luật Trí tuệ nhân tạo (Luật số: 134/2025/QH15) có hiệu lực...",
        options: [
            "A. Ngày 01/01/2026",
            "B. Ngày 01/06/2026",
            "C. Ngày 01/07/2026",
            "D. Ngày 01/12/2026"
        ],
